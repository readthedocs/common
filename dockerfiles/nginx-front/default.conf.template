server {
    listen 80;
    server_name .devthedocs.com;
    client_max_body_size 0;

    location / {
        proxy_pass http://host.docker.internal:${RTDDEV_FRONT_BUSINESS_PORT};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
    }
}

# Community also serves custom domains, so it gets everything else.
server {
    listen 80 default_server;
    client_max_body_size 0;

    location / {
        proxy_pass http://host.docker.internal:${RTDDEV_FRONT_COMMUNITY_PORT};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
    }
}
